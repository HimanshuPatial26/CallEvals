# Copy this file to .env and fill in your own values. Nothing here should be committed.

# Which extraction provider to use: "gemini" (default, free tier, structured output
# enforced by the API) or "groq" (hosted, needs an API key, fast inference — but Groq's
# JSON mode only guarantees valid JSON, not a specific shape, so extraction failures
# there show up as validation errors rather than malformed responses).
EXTRACTION_PROVIDER=gemini

# Free-tier Gemini API key (https://ai.google.dev) — used for summary/next-step/objection
# extraction. No GCP billing account required for the free tier.
GEMINI_API_KEY=

# Model used for extraction. Keep it on a flash-tier model — extraction is a short,
# structured-output task and does not need a "pro" model. Check ai.google.dev for the
# current free-tier model names before relying on this default.
GEMINI_MODEL=gemini-2.5-flash

# Only needed if EXTRACTION_PROVIDER=groq. Free-credit key from https://console.groq.com.
GROQ_API_KEY=

# Model used for Groq extraction. Check https://console.groq.com/docs/models for the
# current hosted model catalog before relying on this default.
GROQ_MODEL=llama-3.3-70b-versatile

# Which ASR provider to use: "faster_whisper" (default, free, self-hosted, needs
# ffmpeg + a one-time model download) or "deepgram" (hosted, needs an API key and
# real network access, bills per minute after the account's free credit runs out).
ASR_PROVIDER=faster_whisper

# faster-whisper model size. "base" or "small" run fine on CPU for Phase 0's mock-call
# volume; requires no API key and no billing — it's the free, self-hosted ASR path.
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Only needed if ASR_PROVIDER=deepgram. Free-credit key from https://console.deepgram.com.
# Gets native multichannel transcription (skips the local dual-channel split) and real
# diarization (via diarize=true) for mono calls or a dual-channel file that didn't
# actually separate — see app/asr/deepgram_provider.py.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# Which physical channel of a dual-channel recording is the rep: 0 or 1. This is a
# dialer/recorder export convention, not something the audio file itself says — if
# transcripts have rep/customer swapped, flip this. Affects both ASR paths.
REP_CHANNEL_INDEX=0

# Only relevant when ASR_PROVIDER=deepgram and a call falls back to diarization
# (a mono call, or a dual-channel file that didn't actually separate — check a
# call's speaker_source field to see which happened). Diarization has no channel
# to key off REP_CHANNEL_INDEX, so it uses a separate assumption: whichever voice
# is clustered first is this role. True = rep talks first (the norm for outbound
# sales calls). Flip to false if your calls are usually inbound (customer speaks
# first) and diarized transcripts are consistently backwards.
FIRST_DIARIZED_SPEAKER_IS_REP=true

# Where uploaded audio and pipeline results are stored. Phase 0 uses the filesystem —
# no database. Revisit once Phase 1 needs multi-tenant storage.
DATA_DIR=./data
