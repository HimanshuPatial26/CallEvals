# Copy this file to .env and fill in your own values. Nothing here should be committed.

# Free-tier Gemini API key (https://ai.google.dev) — used for summary/next-step/objection
# extraction. No GCP billing account required for the free tier.
GEMINI_API_KEY=

# Model used for extraction. Keep it on a flash-tier model — extraction is a short,
# structured-output task and does not need a "pro" model. Check ai.google.dev for the
# current free-tier model names before relying on this default.
GEMINI_MODEL=gemini-2.5-flash

# Which extraction provider to use: "gemini" (default, native structured-output
# schema mode, but capped at 20 requests/day on the free tier) or "groq" (hosted
# open-weight models via Groq's much more generous free tier — see
# app/extraction/groq_extractor.py for the tradeoffs).
EXTRACTION_PROVIDER=gemini

# Only needed if EXTRACTION_PROVIDER=groq. Free key from https://console.groq.com/keys.
# llama-3.3-70b-versatile (this file's original default) was decommissioned by
# Groq and started 404ing — confirmed live by a user, not from this sandbox
# (its egress proxy blocks api.groq.com/console.groq.com outright, so nobody
# building from here can verify Groq model ids directly). openai/gpt-oss-120b
# below is confirmed live as of 2026-08-08. Groq retires/renames model ids over
# time regardless — a 404 means the model no longer exists, not a wrong URL;
# check https://console.groq.com/docs/models if this one goes stale too.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Which ASR provider to use: "faster_whisper" (default, free, self-hosted, needs
# ffmpeg + a one-time model download) or "deepgram" (hosted, needs an API key and
# real network access, bills per minute after the account's free credit runs out).
ASR_PROVIDER=faster_whisper

# faster-whisper model size. "base" or "small" run fine on CPU for Phase 0's mock-call
# volume; requires no API key and no billing — it's the free, self-hosted ASR path.
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Only needed if ASR_PROVIDER=deepgram. Free-credit key from https://console.deepgram.com.
# Gets native multichannel transcription (skips the local dual-channel split) and could
# get real mono diarization via diarize=true, but that's deliberately not wired in here —
# see app/asr/deepgram_provider.py for why.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# Where uploaded audio and pipeline results are stored. Phase 0 uses the filesystem —
# no database. Revisit once Phase 1 needs multi-tenant storage.
DATA_DIR=./data
