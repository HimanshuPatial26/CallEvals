# Copy this file to .env and fill in your own values. Nothing here should be committed.

# Free-tier Gemini API key (https://ai.google.dev) — used for summary/next-step/objection
# extraction. No GCP billing account required for the free tier.
GEMINI_API_KEY=

# Model used for extraction. Keep it on a flash-tier model — extraction is a short,
# structured-output task and does not need a "pro" model. Check ai.google.dev for the
# current free-tier model names before relying on this default.
GEMINI_MODEL=gemini-2.5-flash

# faster-whisper model size. "base" or "small" run fine on CPU for Phase 0's mock-call
# volume; requires no API key and no billing — it's the free, self-hosted ASR path.
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Where uploaded audio and pipeline results are stored. Phase 0 uses the filesystem —
# no database. Revisit once Phase 1 needs multi-tenant storage.
DATA_DIR=./data
